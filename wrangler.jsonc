{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syrava-factory",
  "compatibility_date": "2026-08-05",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./apps/website/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "factory.syrava.com",
      "custom_domain": true
    }
  ]
}
